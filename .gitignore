#env
.env
.env.*
# El ejemplo sí se versiona: solo tiene marcadores de posición y el README
# manda copiarlo a .env.local. Ignorado, quien clona el repo no lo recibe.
!.env.local.example

# Logs
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.env
.vite

# Temporales varios
.branches
.temp

# Remotion render outputs
remotion/out

# Media pesada de redes sociales (no se despliega; vive fuera del bundle)
_media-archivo/

# Wrangler local state (miniflare cache)
**/.wrangler/
.wrangler/

# Remotion: dependencias y renders
remotion/node_modules/
remotion/out/

# Remotion: audio fuente (música + voces). Pesa ~38 MB y NO se despliega
# (Cloudflare solo publica dist/). Se regenera con los scripts gen-*-voices.mjs
# y gen-music.mjs. Vive local, no tiene por qué viajar en el repo.
remotion/public/*.wav
remotion/public/*.mp3

# Backend antiguo (Supabase + panel admin), conservado como referencia
_legacy/

# Tooling de agente (Claude Code / skills). Config de herramientas, no del sitio.
.claude/
.agents/
skills-lock.json
