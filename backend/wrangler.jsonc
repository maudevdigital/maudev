{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maudev-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  // workers.dev activo: el build del sitio en GitHub Actions descarga las guías
  // desde ahí, porque la protección contra bots de la zona maudev.cl bloquea las
  // IPs de GitHub. El admin sigue exigiendo el JWT de Access (auth/admin.ts) y
  // la cookie de cliente es __Host- de maudev.cl: no viaja a este dominio.
  "workers_dev": true,
  "preview_urls": false,
  // Mismo dominio que el sitio: Pages sirve maudev.cl y este Worker atiende solo
  // /api/*. Mismo origen, así que las cookies __Host- funcionan sin CORS.
  "routes": [{ "pattern": "maudev.cl/api/*", "zone_name": "maudev.cl" }],
  "vars": {
    "SITIO": "https://maudev.cl",
    "ENTORNO": "produccion",
    // Correos con permiso de admin, separados por coma. Además de estar acá,
    // tienen que pasar Cloudflare Access (ver docs/plan-servicios-portal.md §8.1).
    "ADMINS": "contacto@maudev.cl,lucasmaulenr@gmail.com",
    // Se completan al crear la aplicación en Cloudflare Access:
    "ACCESS_EQUIPO": "maudevchile.cloudflareaccess.com",
    "ACCESS_AUD": "d8f4dee20546d58261fb21e4dae97d42b1b24cd64e79fb8d588ed0a4302d1f1b",
    "GITHUB_REPO": "maudevdigital/maudev"
  },
  // La misma base que ya usa workers/lead-intake: el backend la absorbe en la
  // entrega 2d y así no hay que mover datos.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maudev-leads",
      "database_id": "fd24eb0f-0d69-4215-9ed7-5da04126e728",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "LIMITE_TOKEN", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": { "enabled": true },
  // Solo para `npm run dev`. Sin la ruta de producción, wrangler no reescribe la
  // URL a maudev.cl y el atajo de admin local (auth/admin.ts) puede exigir
  // localhost. ADMIN_LOCAL existe únicamente acá: nunca llega a producción.
  "env": {
    "local": {
      "routes": [],
      "vars": {
        "SITIO": "http://127.0.0.1:5173",
        "ENTORNO": "local",
        "ADMINS": "contacto@maudev.cl,lucasmaulenr@gmail.com",
        "ADMIN_LOCAL": "contacto@maudev.cl",
        "ACCESS_EQUIPO": "",
        "ACCESS_AUD": "",
        "GITHUB_REPO": "maudevdigital/maudev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "maudev-leads",
          "database_id": "fd24eb0f-0d69-4215-9ed7-5da04126e728",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
