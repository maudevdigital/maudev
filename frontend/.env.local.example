# URL del worker que recibe los leads del formulario (workers/lead-intake).
# Copia la Production URL del nodo Webhook de tu workflow de captación.
#
# ⚠️ OBLIGATORIA, y ahora además CRÍTICA. Ya no hay fallback: el worker
# ig-autopost/notify-lead se dio de baja. Si esta variable falta, el formulario
# falla con error explícito.
#
# Antes acá decía que daba un poco lo mismo porque el CTA principal era
# WhatsApp. Dejó de ser cierto: el hero y el bloque de planes ahora llevan al
# formulario, así que sin esta variable se cae el camino principal de contacto
# del sitio. El respaldo es el aviso de error, que ofrece abrir WhatsApp.
VITE_LEAD_WEBHOOK_URL=https://maudev-lead-intake.<cuenta>.workers.dev

# Número de WhatsApp del negocio, sin "+" ni espacios (56984848226).
#
# Opcional. Sin ella se usa el número personal que está por defecto en
# src/lib/whatsapp.js. Alimenta los ~13 puntos del sitio que abren un chat.
#
# ⚠️ En producción NO se lee de acá ni del panel de Cloudflare: el build corre
# en GitHub Actions, así que vive en Settings → Secrets → Actions y además
# necesita su línea en .github/workflows/deploy.yml. Vite congela las VITE_* en
# el momento del build y Cloudflare solo recibe el dist ya compilado, así que
# una variable definida en Cloudflare nunca llega al bundle.
VITE_WHATSAPP_NUMBER=56984848226

# Site key PÚBLICA de Cloudflare Turnstile (viaja en el HTML del sitio, no es
# un secreto). Opcional: sin ella no se carga el widget y el formulario funciona
# como siempre.
#
# En producción NO se lee de acá: el build corre en GitHub Actions, así que vive
# en Settings → Secrets → Actions del repositorio.
#
# ⚠️ Formato: toda variable necesita su signo igual. Una línea suelta del tipo
# `nombre valor` no se ignora —dotenv se come como parte de ESE nombre todo lo
# que venga después, y las variables siguientes dejan de existir en silencio.
# Pasó con esta misma clave.
#
# La secret key NO va en ningún archivo del proyecto:
#   cd workers/lead-intake && wrangler secret put TURNSTILE_SECRET
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA_tu_site_key
