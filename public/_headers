# Headers de seguridad para Cloudflare Pages (se aplican a todo el sitio).
/*
  Strict-Transport-Security: max-age=15552000; includeSubDomains
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  # Content-Security-Policy: la lista de orígenes desde los que el navegador
  # acepta cargar algo. Si a alguien le entra código por una dependencia
  # comprometida o un tercero hackeado, el navegador se niega a ejecutarlo
  # porque no viene de acá. No evita que entre; evita que sirva de algo.
  #
  # Los orígenes NO se adivinaron: salen de recorrer el sitio registrando cada
  # petición por tipo de recurso. Turnstile usa subdominios propios
  # (brunhild.challenges.cloudflare.com), de ahí el comodín.
  #
  # cloudflareinsights.com está acá porque Cloudflare Pages inyecta su script de
  # analítica por su cuenta, solo en producción. No aparece en el sitio
  # compilado ni en el preview local, así que el recorrido previo no podía
  # verlo: se detectó recorriendo maudev.cl ya publicado. Cualquier CSP de este
  # proyecto hay que verificarla también contra el sitio en vivo.
  #
  # `unsafe-inline` en script-src es una concesión conocida: index.html lleva
  # dos scripts en línea (tema y consentimiento) y _headers es estático, así
  # que no hay forma de emitir un nonce por respuesta. Aun así script-src sigue
  # cortando lo que más importa, que es cargar JavaScript desde un dominio no
  # autorizado.
  #
  # Estuvo primero en modo reporte y se recorrieron diecisiete rutas más el
  # envío del formulario sin una sola violación, así que ahora bloquea de
  # verdad. `npm run test:csp` repite esa comprobación contra ESTE archivo: si
  # el sitio suma un servicio externo, falla antes de salir a producción.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://challenges.cloudflare.com https://*.challenges.cloudflare.com https://www.googletagmanager.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://www.googletagmanager.com https://www.google-analytics.com https://www.facebook.com https://challenges.cloudflare.com; connect-src 'self' https://cloudflareinsights.com https://static.cloudflareinsights.com https://open.er-api.com https://maudev-lead-intake.maudevchile.workers.dev https://maudev-meta-capi.maudevchile.workers.dev https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com https://stats.g.doubleclick.net https://www.facebook.com https://challenges.cloudflare.com https://*.challenges.cloudflare.com; frame-src https://challenges.cloudflare.com https://*.challenges.cloudflare.com; worker-src 'self' blob:; manifest-src 'self'

# Revalidar los chunks evita fijar en caché una respuesta 404 durante la breve
# propagación entre el HTML de un deploy y sus assets.
/assets/*
  Cache-Control: public, max-age=0, must-revalidate

/404.html
  Cache-Control: no-store
  X-Robots-Tag: noindex

# Imágenes del sitio: cambian solo al desplegar una nueva versión.
/img/*
  Cache-Control: public, max-age=2592000

/portfolio/*
  Cache-Control: public, max-age=2592000

/social/*
  Cache-Control: public, max-age=2592000

# Utilidades fuera de la arquitectura comercial. /precios ya NO va acá: la
# página se reconstruyó para posicionar ("cuánto cuesta una página web en
# Chile") y está en el sitemap. Una URL del sitemap con noindex es un error
# reportado en Search Console, además de trabajo tirado.
/ig
  X-Robots-Tag: noindex, follow

/links
  X-Robots-Tag: noindex, follow
