# Headers de seguridad para Cloudflare Pages (se aplican a todo el sitio).
/*
  Strict-Transport-Security: max-age=15552000; includeSubDomains
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()

# Assets con hash → caché larga (mejora "caché eficiente").
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Imágenes del sitio: cambian solo al desplegar una nueva versión.
/img/*
  Cache-Control: public, max-age=2592000

/portfolio/*
  Cache-Control: public, max-age=2592000

/social/*
  Cache-Control: public, max-age=2592000

# Utilidades y catálogo técnico fuera de la arquitectura comercial.
/precios
  X-Robots-Tag: noindex, follow

/ig
  X-Robots-Tag: noindex, follow

/links
  X-Robots-Tag: noindex, follow
