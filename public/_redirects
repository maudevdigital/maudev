# Redirecciones permanentes de la arquitectura anterior.
/servicios          /desarrollo-web      301
/automatizaciones   /automatizacion      301
/portafolio         /casos               301
/portafolio/*       /casos/:splat        301
/sobre-nosotros     /nosotros            301

# Rutas históricas sin contenido propio.
/cotizador          /contacto             301
/diagnostico-web    /contacto             301

# /blog/* NO se resuelve acá: lo maneja functions/blog/[[path]].js, que hace
# 301 uno por uno cuando existe equivalente y 410 Gone cuando no. `_redirects`
# no soporta 410 y un 301 masivo a la portada sería un soft 404.

# Un asset inexistente debe responder 404. Si cae en el fallback SPA,
# Cloudflare puede cachear index.html bajo una URL de JavaScript y dejar la
# aplicación en blanco durante un despliegue.
/assets/*            /404.html             404

# Fallback para React Router.
/*                  /index.html           200
